new file mode 100644
index 0000000..dd1ec9b
--- /dev/null
+++ b/frigate/util/netwatch_config.py
@@ -0,0 +1,112 @@
+"""Durable writes to Frigate's authoritative configuration (no camera registry)."""
+
+import fcntl
+import os
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+from threading import RLock
+from urllib.parse import urlsplit
+
+from ruamel.yaml import YAML
+
+from frigate.util.builtin import update_yaml_file_bulk
+
+_lock = RLock()
+
+
+@contextmanager
+def locked_config(path):
+    with _lock:
+        fd = os.open(str(path) + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX)
+            yield
+        finally:
+            os.close(fd)
+
+
+def camera_streams(name, camera):
+    if not camera:
+        return set()
+    streams = {name, *camera.get("live", {}).get("streams", {}).values()}
+    for item in camera.get("ffmpeg", {}).get("inputs", []):
+        path = urlsplit(item.get("path", ""))
+        if path.hostname in {"127.0.0.1", "localhost"} and path.port == 8554:
+            streams.add(path.path.lstrip("/"))
+    return streams
+
+
+def prune_removed_streams(before, after):
+    """Remove sources owned only by deleted cameras; preserve shared sources."""
+    old = before.get("cameras", {}) or {}
+    new = after.get("cameras", {}) or {}
+    removed = set(old) - {name for name, camera in new.items() if camera}
+    candidates = set().union(*(camera_streams(n, old[n]) for n in removed))
+    retained = set().union(*(camera_streams(n, c) for n, c in new.items() if c))
+    streams = after.get("go2rtc", {}).get("streams", {})
+    for name in candidates - retained:
+        streams.pop(name, None)
+    for name in removed:
+        new.pop(name, None)
+
+
+def commit_config(path, validate, *, text=None, updates=None):
+    """Validate privately, fsync and atomically replace; failure keeps the old file."""
+    path = Path(path)
+    with locked_config(path):
+        old_text = path.read_text()
+        fd, temporary = tempfile.mkstemp(
+            prefix=".netwatch-config-", suffix=path.suffix, dir=path.parent
+        )
+        try:
+            with os.fdopen(fd, "w") as out:
+                out.write(old_text if text is None else text)
+            if updates is not None:
+                update_yaml_file_bulk(temporary, updates)
+            yaml = YAML()
+            before = yaml.load(old_text)
+            with open(temporary) as source:
+                after = yaml.load(source)
